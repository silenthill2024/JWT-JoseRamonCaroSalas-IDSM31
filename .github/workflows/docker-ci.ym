name: Build and Push Docker Image

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  build-test-push:
    runs-on: ubuntu-latest

    # Definimos MongoDB como un servicio en la red de GitHub Actions
    services:
      mongodb:
        image: mongo:7
        ports:
          - 27017:27017

    steps:
      - name: Descargar código
        uses: actions/checkout@v4

      - name: Iniciar sesión en Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ vars.DOCKER_USERNAME }}
          password: ${{ secrets.DOCKER_PASSWORD }}

      - name: Configurar Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Construir imagen para pruebas
        uses: docker/build-push-action@v6
        with:
          context: .
          load: true
          tags: carrito-app:test

      - name: Ejecutar pruebas dentro del contenedor
        run: |
          docker run --rm \
            -e MONGODB_URI=mongodb://host.docker.internal:27017/carritoDB \
            -e JWT_SECRET=tu_clave_secreta \
            carrito-app:test

      - name: Construir y publicar imagen
        uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: ${{ vars.DOCKER_USERNAME }}/carrito-app:latest